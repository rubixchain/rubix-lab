# Per-desktop runtime state — binaries, generated config, IPFS state, and
# DID private keys all end up here once setup.sh runs. None of it belongs
# in the repo: binaries are large/binary-diff-noisy, config.toml embeds
# this lab's real bootstrap IPs, and DID keys are private key material.
# Keep the folder structure (via nodes/.gitkeep) but never its contents.
/nodes/*
!/nodes/.gitkeep

# Local AI agent context — personal tooling, not part of the lab setup.
CLAUDE.md
.claude/

# Real host lists contain internal lab IPs. Only the .example files are tracked.
controller/hosts.txt
controller/exec-update/hosts.txt

# Written by check-nodes.py / dids-to-excel.py / node-versions.py — point-in-time
# snapshots with real IPs and DIDs.
controller/inventory.json
controller/dids.xlsx
controller/versions.xlsx

# Written by the test-plan preflight and asset runners — point-in-time
# snapshots with real IPs and DIDs.
controller/test-plan/full-test/preflight-context.json
controller/test-plan/full-test/smoke-test-roles.txt

# Local mutable state, not shared history — same reasoning as hosts.txt
# above. NOTE: unlike the files above, this one is NOT safely disposable —
# it's the only record of which local-RBT token index range has been
# allocated fleet-wide, and can't be reconstructed from the network. Don't
# delete it on the controller; see rubix_client.py's comment on it.
controller/test-plan/full-test/token_index_registry.json

# Every test-plan script's report lands here (repo-root reports/), timestamped
# per run — real fleet data, not something to commit.
/reports/

# Python runtime artifacts and local virtualenvs — regenerated on every run,
# never meant to be tracked.
__pycache__/
*.pyc
.venv/
venv/

# direnv's local, per-machine env config.
.envrc
