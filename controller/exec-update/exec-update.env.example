# exec-update settings.  cp exec-update.env.example exec-update.env  and edit.
#
# The real exec-update.env is gitignored - it describes THIS controller's
# layout, which differs per machine.
#
# An exported variable beats this file, so a one-off override still works:
#   REPO_DIR=/some/other/checkout ./update-exec.sh my-branch --all
#
# "~/" is expanded to your home directory. Values are literal otherwise -
# no $VAR substitution.
#
# Where the nodes live on the lab machines is NOT a setting any more: every
# node is ~/rubix-lab/nodes/node<slot> (systems/install/setup.sh), and
# controller/fleet.py knows the slots.


# git checkout of rubixgoplatform used to BUILD. Only the controller needs it;
# the lab machines never see source code.
REPO_DIR=~/Desktop/rubixgoplatform

# Optional: skip the build and ship a binary produced elsewhere. Useful when
# the controller has no Go toolchain. Must be a LINUX (ELF) binary - the
# Makefile sets CGO_ENABLED=1, so it cannot be cross-compiled from Windows or
# macOS without a C toolchain. Leave commented out for the normal build path.
# PREBUILT_BINARY=/tmp/rubixgoplatform-fix

# SSH user on the fleet.
SSH_USER=rubix

# Concurrent machines. 0 = all at once (default). Set 1 to watch one at a time
# when chasing a failure.
JOBS=0
